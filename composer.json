{
  "name": "bad-otter-labs/ultimate-commerce-quality",
  "description": "Pinned development quality toolchain for Ultimate Commerce.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
    "php-stubs/woocommerce-stubs": "11.1.0",
    "php-stubs/wordpress-stubs": "7.1.0",
    "phpcompatibility/phpcompatibility-wp": "2.1.8",
    "phpstan/phpstan": "2.2.14",
    "squizlabs/php_codesniffer": "3.13.6",
    "szepeviktor/phpstan-wordpress": "2.0.4",
    "wp-coding-standards/wpcs": "3.4.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "quality:wpcs": "phpcs --standard=phpcs.xml.dist",
    "quality:compat": "phpcs --standard=phpcompatibility.xml.dist",
    "quality:phpstan": "phpstan analyse --configuration=phpstan.neon --no-progress"
  }
}
