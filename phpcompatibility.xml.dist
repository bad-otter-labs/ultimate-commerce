<?xml version="1.0"?>
<ruleset name="Ultimate Commerce PHP Compatibility">
    <description>PHPCompatibilityWP gate for the canonical Free package's PHP 8.1+ support claim.</description>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="4"/>
    <arg value="sp"/>

    <file>packages/ultimate-commerce-for-woocommerce</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>

    <config name="testVersion" value="8.1-"/>

    <rule ref="PHPCompatibilityWP"/>
</ruleset>
