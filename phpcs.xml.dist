<?xml version="1.0"?>
<ruleset name="Ultimate Commerce WordPress Coding Standards">
    <description>Repository-level WPCS gate for the canonical Free WordPress.org package.</description>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="4"/>
    <arg value="sp"/>

    <file>packages/ultimate-commerce-for-woocommerce</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>

    <config name="minimum_supported_wp_version" value="6.6"/>

    <rule ref="WordPress-Extra"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="ultimate-commerce-for-woocommerce"/>
        </properties>
    </rule>
</ruleset>
